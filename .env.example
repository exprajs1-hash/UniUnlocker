# Copy to .env.local for development. Set the same values in your host for production.

# Required ------------------------------------------------------------------
MONGODB_URI=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Only read by `npm run seed`, which creates the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL, used for SEO, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Optional: Search engine ownership verification (Google Search Console / Bing Webmaster).
# Paste only the content="..." value of the HTML-tag method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Required for admin image uploads ------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: Cloudinary folder for uploads (default "uniunlocker"). Nested works, e.g. uniunlocker/images
CLOUDINARY_FOLDER=uniunlocker

# Optional: enables the admin Pexels picker and picks seed images from the API.
PEXELS_API_KEY=

# Tool Rent: GSM-THEME / DHRU-compatible provider API ------------------------
GSM_API_URL=https://your-provider.com/public/api/index.php
GSM_API_USERNAME=
GSM_API_KEY=
# Optional: fixed-IP HTTP proxy for providers that whitelist IPs (Vercel's IPs change).
# Turn on "Connect through the fixed-IP proxy" for those providers in the admin panel.
# Format: http://user:password@SERVER_IP:PORT
PROVIDER_PROXY_URL=

# Email (SMTP) for sign-up verification codes and password reset ------------------
# Gmail: smtp.gmail.com, port 465, your Gmail address and a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords).
# Hosting email (cPanel etc.): mail.yourdomain.com, port 465, the mailbox address and its password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Shown as the sender, e.g. "UniUnlocker <no-reply@uniunlocker.com>". Defaults to SMTP_USER.
SMTP_FROM=

# Background order checks -----------------------------------------------------------
# Lets /api/cron/orders check open orders with the providers every minute, even when
# nobody has the orders page open. Use a long random value (at least 16 characters).
# Then create a free job at https://cron-job.org that calls, every 1 minute:
#   GET https://YOUR-DOMAIN/api/cron/orders
#   with the header  Authorization: Bearer <CRON_SECRET>
# (Vercel's own Cron only runs once a day on the free plan.)
CRON_SECRET=

# Where "New custom order" emails go. Defaults to ADMIN_EMAIL.
ADMIN_NOTIFY_EMAIL=

# ZiniPay online payments ("Add balance"). Leave empty to keep the WhatsApp/Telegram link instead.
# Key: ZiniPay Dashboard > Brands > Brand Key / API Key. Webhook: <site URL>/api/payments/zinipay
ZINIPAY_API_KEY=
