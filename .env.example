# Copy to .env.local for development. Set the same values in your host for production.

# Required ------------------------------------------------------------------
MONGODB_URI=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Only read by `npm run seed`, which creates the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public URL, used for SEO, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Required for admin image uploads ------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: Cloudinary folder for uploads (default "uniunlocker"). Nested works, e.g. uniunlocker/images
CLOUDINARY_FOLDER=uniunlocker

# Optional: enables the admin Pexels picker and picks seed images from the API.
PEXELS_API_KEY=
